# WaveCraft Environment Configuration Example
# Copy this file to .env.local to customize local development settings.

# Local Vite development server port (default: 3000)
PORT=3000

# Optional custom API Gateway URL (defaults to serverless /api/music or production proxy)
# VITE_API_BASE_URL=https://wavecraft-alpha.vercel.app

# Optional LLM API Keys for AI Smart DJ Studio
# Note: WaveCraft has a built-in semantic vibe intelligence engine that works with zero API keys.
# Providing a key activates deep generative storytelling commentary.
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
# VITE_OPENAI_API_KEY=your_openai_api_key_here
