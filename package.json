{
  "name": "wavecraft",
  "private": true,
  "version": "5.2.5",
  "description": "Next-generation spatial glass music streaming platform with Web Audio DSP, AI Vibe DJ, Syllable-Synced Live Lyrics, 1-Tap Offline Vault, and Native Android & Windows desktop support.",
  "author": "Pradeep",
  "license": "MIT",
  "homepage": "https://wavecraft-alpha.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pradeep28012010/WaveCraft.git"
  },
  "bugs": {
    "url": "https://github.com/Pradeep28012010/WaveCraft/issues"
  },
  "keywords": [
    "music",
    "music-streaming",
    "react18",
    "typescript",
    "tailwind-v4",
    "web-audio-api",
    "dsp",
    "equalizer",
    "audiophile",
    "ai-dj",
    "lyrics",
    "pwa",
    "capacitor",
    "electron",
    "offline-first",
    "jam-room",
    "vinyl-player",
    "spatial-audio"
  ],
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "electron:dev": "electron electron/main.cjs",
    "build:win": "node ./scripts/build-electron.cjs --win nsis",
    "build:win:dir": "node ./scripts/build-electron.cjs --win dir",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test test/**/*.test.js",
    "lint": "eslint .",
    "preview": "node ./node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "colorthief": "^2.4.0",
    "framer-motion": "^11.0.0",
    "gsap": "^3.15.0",
    "idb-keyval": "^6.2.1",
    "mathjs": "^15.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
